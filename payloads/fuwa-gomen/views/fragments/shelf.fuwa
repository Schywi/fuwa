<div class="fg-shelf">
  <button
    type="button"
    class="fg-food"
    f-for="item in items"
    data-item-id="&item.id"
    data-price="&item.price"
    hx-get="/buy/&item.id"
    hx-target="#gomen"
    hx-select="#gomen"
    hx-swap="outerHTML"
  >
    <span class="fg-food-icon">&item.icon</span>
    <span class="fg-food-price">¥&item.price</span>
  </button>
</div>
