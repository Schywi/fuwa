module Gomen

action index(req) do
  local state = require("pages.gomen_state")
  return render("gomen", state.page())
end

action poke(req) do
  local state = require("pages.gomen_state")
  return render("gomen", state.poke())
end

action cooldown(req) do
  local state = require("pages.gomen_state")
  return render("gomen", state.cooldown())
end

action buy_onigiri(req) do
  local state = require("pages.gomen_state")
  return render("gomen", state.buy("onigiri"))
end

action buy_ramen(req) do
  local state = require("pages.gomen_state")
  return render("gomen", state.buy("ramen"))
end

action buy_takoyaki(req) do
  local state = require("pages.gomen_state")
  return render("gomen", state.buy("takoyaki"))
end

action buy_sushi(req) do
  local state = require("pages.gomen_state")
  return render("gomen", state.buy("sushi"))
end

action calm(req) do
  local state = require("pages.gomen_state")
  return render("gomen", state.calm())
end

action reset(req) do
  local state = require("pages.gomen_state")
  return render("gomen", state.reset())
end
