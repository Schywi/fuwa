# Tiltfile — dev workflow for fuwa OpenResty dev server.
# Start with:  tilt up
# Or via:      ./dev.sh

# OpenResty service with live-reload
docker_compose('./infra/docker-compose.yml')

# Watch Lua files — no rebuild needed (lua_code_cache off),
# but we print the changed file for visibility
local_resource(
  'lua-sources',
  labels=['Lua'],
  trigger_mode=TRIGGER_MODE_AUTO,
)
watch_file('./runtime/**/*.lua', 'lua-sources')
watch_file('./shell/**/*.lua', 'lua-sources')
watch_file('./payloads/**/*.lua', 'lua-sources')

# Watch .fuwa files
local_resource(
  'fuwa-sources',
  labels=['fuwa'],
  trigger_mode=TRIGGER_MODE_AUTO,
)
watch_file('./shell/**/*.fuwa', 'fuwa-sources')
watch_file('./payloads/**/*.fuwa', 'fuwa-sources')

# Watch nginx.conf changes — these need a container restart
local_resource(
  'nginx-config',
  labels=['nginx'],
  trigger_mode=TRIGGER_MODE_AUTO,
)
watch_file('./nginx.conf', 'nginx-config')

# Print the URL on startup
local('echo')
local_resource(
  'fuwa-dev',
  serve_cmd='echo "fuwa dev → http://localhost:8080"',
  labels=['dev'],
)
