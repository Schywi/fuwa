# ── Fuwa runtime ──────────────────────────────────────────────────
FUWA_TRACE=db,host,render,compile
PORT=8080

# ── Terraform / DigitalOcean ──────────────────────────────────────
# https://cloud.digitalocean.com/account/api/tokens
DIGITALOCEAN_TOKEN=

# SSH key (choose one):
#   Persistent: upload via DO Dashboard → Settings → Security → Add SSH Key
#               name it "fuwa", then set:
TF_VAR_ssh_key_name=fuwa
#   Ephemeral: leave empty, Terraform uploads ~/.ssh/id_ed25519.pub each apply
# TF_VAR_ssh_key_name=

# ── Terraform / Cloudflare ────────────────────────────────────────
# https://dash.cloudflare.com/profile/api-tokens
# Token needs: Zone.DNS — Edit permission
CLOUDFLARE_API_TOKEN=
TF_VAR_cf_zone_id=        # found in Cloudflare Overview sidebar

# ── Domain ────────────────────────────────────────────────────────
TF_VAR_domain=            # e.g. example.com
TF_VAR_subdomain=fuwa     # default: fuwa → fuwa.example.com

# ── Ansible ───────────────────────────────────────────────────────
# Droplet IP (from terraform output droplet_ip)
FUWA_HOST=

# Path to the private SSH key matching the public key uploaded to DO
# Ansible uses this to connect as root.
# Default: ~/.ssh/id_ed25519 (if you used ed25519 key pair)
ANSIBLE_PRIVATE_KEY_FILE=~/.ssh/id_ed25519
ANSIBLE_SSH_PRIVATE_KEY=

# ── Let's Encrypt ─────────────────────────────────────────────────
TF_VAR_fuwa_email=        # e.g. you@example.com
