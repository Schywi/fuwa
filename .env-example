# ── Fuwa runtime ──────────────────────────────────────────────────
FUWA_TRACE=db,host,render,compile
PORT=8080

# ── Terraform / DigitalOcean ──────────────────────────────────────
# https://cloud.digitalocean.com/account/api/tokens
DIGITALOCEAN_TOKEN=

# ── Terraform / Cloudflare ────────────────────────────────────────
# https://dash.cloudflare.com/profile/api-tokens
# Token needs: Zone.DNS — Edit permission
CLOUDFLARE_API_TOKEN=
TF_VAR_cf_zone_id=        # found in Cloudflare Overview sidebar

# ── Domain ────────────────────────────────────────────────────────
TF_VAR_domain=            # e.g. example.com
TF_VAR_subdomain=fuwa     # default: fuwa → fuwa.example.com

# ── Let's Encrypt ─────────────────────────────────────────────────
TF_VAR_fuwa_email=        # e.g. you@example.com
