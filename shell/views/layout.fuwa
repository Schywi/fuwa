&unsafe doctype
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="htmx-config" content='{"historyEnabled":false,"selfRequestsOnly":false,"allowScriptTags":false}' />
    <title>&title</title>
    <link rel="stylesheet" href="/vendor/xterm/xterm-6.0.0.css" />
    <script type="importmap">
      {
        "imports": {
          "@codemirror/state": "/vendor/codemirror/state-6.6.0.js",
          "@codemirror/view": "/vendor/codemirror/view-6.43.0.js",
          "@marijn/find-cluster-break": "/vendor/codemirror/find-cluster-break-1.0.2.js",
          "crelt": "/vendor/codemirror/crelt-1.0.6.js",
          "style-mod": "/vendor/codemirror/style-mod-4.1.3.js",
          "w3c-keyname": "/vendor/codemirror/w3c-keyname-2.2.8.js"
        }
      }
    </script>
    <script src="/vendor/htmx/htmx-1.9.12.min.js"></script>
    <script defer src="/vendor/petite-vue/petite-vue-0.4.1.iife.js"></script>
    <script defer src="/vendor/gsap/gsap-3.15.0.min.js"></script>
    <script defer src="/shell/hooks/editor.js"></script>
    <script defer src="/shell/hooks/terminal.js"></script>
    <script defer src="/shell/hooks/workspace.js"></script>
    <script defer src="/shell/hooks/runtime-session.js"></script>
    <script defer src="/shell/hooks/preview-browser.js"></script>
    <script defer src="/shell/hooks/preview.js"></script>
    <script defer src="/shell/hooks/observability.js"></script>
    <script defer src="/shell/hooks/motion.js"></script>
    <script defer src="/shell/hooks/cursor.js"></script>
    <style>
      /* ── Darkroom colour system ─────────────────────────────────── */
      :root {
        color-scheme: dark;
        --canvas:     #08080a;
        --emulsion:   #f5f0e8;
        --fixer:      #8a8378;
        --safelight:  #c8402f;
        --developer:  #d8a24a;
        --stop-bath:  #4a90d9;
        --hairline:   rgba(245,240,232,0.06);
        --surface:    rgba(245,240,232,0.025);
        --surface-up: rgba(245,240,232,0.05);
      }

      *, *::before, *::after { box-sizing: border-box; }

      body {
        margin: 0;
        height: 100vh;
        overflow: hidden;
        background: var(--canvas);
        color: var(--emulsion);
        font-family: Avenir Next, Segoe UI, system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      /* ── Grain overlay ──────────────────────────────────────────── */
      body::after {
        content: '';
        position: fixed;
        inset: 0;
        z-index: 9999;
        pointer-events: none;
        opacity: 0.028;
        mix-blend-mode: screen;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
      }

      a, button, textarea, input, select { font: inherit; }

      /* ── Stage ──────────────────────────────────────────────────── */
      .shell-stage {
        height: 100%;
        overflow: hidden;
      }

      .shell-content {
        height: 100%;
      }

      /* ── IDE shell ──────────────────────────────────────────────── */
      .ide-shell {
        display: flex;
        height: 100%;
      }

      /* ── Film strip ─────────────────────────────────────────────── */
      .ide-film-strip {
        flex: 0 0 clamp(170px, 14vw, 240px);
        display: flex;
        flex-direction: column;
        border-right: 1px solid var(--hairline);
        background: var(--canvas);
        overflow: hidden;
      }

      .film-strip-head {
        padding: clamp(14px, 2.4vh, 22px) clamp(10px, 1.2vw, 16px) clamp(10px, 1.6vh, 14px);
        flex-shrink: 0;
      }

      .film-strip-project {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        color: var(--fixer);
        font-weight: 700;
        cursor: pointer;
        transition: color 0.24s ease;
      }

      .film-strip-project:hover {
        color: var(--developer);
      }

      .film-strip-sep {
        height: 1px;
        margin: 0 clamp(10px, 1.2vw, 16px);
        background: var(--hairline);
        flex-shrink: 0;
      }

      .film-strip-files {
        flex: 1;
        overflow-y: auto;
        padding: clamp(4px, 0.6vh, 8px) 0;
      }

      .film-strip-file {
        display: flex;
        align-items: center;
        gap: 7px;
        width: 100%;
        min-height: 28px;
        padding: 0 clamp(10px, 1.2vw, 16px);
        border: none;
        border-left: 2px solid transparent;
        background: transparent;
        color: var(--fixer);
        font-size: 0.78rem;
        font-weight: 500;
        letter-spacing: 0.01em;
        cursor: pointer;
        text-align: left;
        transition: color 0.2s ease, background-color 0.2s ease;
      }

      .film-strip-file:hover {
        background: var(--surface);
        color: var(--emulsion);
      }

      .film-strip-file[data-selected="true"] {
        border-left-color: var(--developer);
        color: var(--developer);
        background: rgba(216,162,74,0.06);
        font-weight: 650;
      }

      .film-strip-file-dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: currentColor;
        opacity: 0;
        flex-shrink: 0;
        transition: opacity 0.2s ease;
      }

      .film-strip-file[data-selected="true"] .film-strip-file-dot {
        opacity: 1;
      }

      .film-strip-file-name {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .film-strip-foot {
        padding: clamp(8px, 1.2vh, 14px) clamp(10px, 1.2vw, 16px);
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .film-strip-status-line {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 0.66rem;
        color: var(--fixer);
        font-weight: 600;
        letter-spacing: 0.03em;
      }

      .film-strip-status-dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--fixer);
      }

      .film-strip-status-dot[data-status="ok"] {
        background: #34d399;
        box-shadow: 0 0 6px rgba(52,211,153,0.4);
      }

      .film-strip-status-dot[data-status="error"] {
        background: var(--safelight);
        box-shadow: 0 0 6px rgba(200,64,47,0.4);
      }

      .film-strip-status-dot[data-status="idle"] {
        background: var(--fixer);
      }

      /* ── Develop button ─────────────────────────────────────────── */
      .shell-develop-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        height: 32px;
        padding: 0 14px;
        border: 1px solid var(--developer);
        background: transparent;
        color: var(--developer);
        font-size: 0.64rem;
        font-weight: 800;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        cursor: pointer;
        transition: background-color 0.24s ease, color 0.24s ease, box-shadow 0.24s ease;
      }

      .shell-develop-btn:hover {
        background: var(--developer);
        color: var(--canvas);
        box-shadow: 0 0 24px rgba(216,162,74,0.18);
      }

      .shell-develop-btn:active {
        transition: background-color 0.06s ease;
        background: #b8892f;
      }

      .shell-develop-btn[data-state="developing"] {
        background: var(--developer);
        color: var(--canvas);
        animation: develop-pulse 1.6s ease-in-out infinite;
      }

      @keyframes develop-pulse {
        0%, 100% { box-shadow: 0 0 12px rgba(216,162,74,0.12); }
        50%      { box-shadow: 0 0 32px rgba(216,162,74,0.3); }
      }

      /* ── Preview zone ───────────────────────────────────────────── */
      .ide-preview-zone {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
      }

      .ide-preview-stage {
        flex: 1;
        min-height: 0;
        overflow: hidden;
        background: var(--canvas);
      }

      .shell-preview-frame {
        display: block;
        width: 100%;
        height: 100%;
        border: 0;
        background: var(--canvas);
      }

      .shell-preview-error {
        padding: clamp(16px, 3vh, 32px);
        color: var(--safelight);
        font-weight: 650;
        font-size: 0.88rem;
      }

      /* ── Right panel ────────────────────────────────────────────── */
      .ide-panel {
        flex: 0 0 clamp(360px, 42vw, 580px);
        min-width: 0;
        display: flex;
        flex-direction: column;
        border-left: 1px solid var(--hairline);
        background: var(--surface);
      }

      /* ── Header ─────────────────────────────────────────────────── */
      .ide-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: clamp(8px, 1.2vh, 14px) clamp(12px, 1.6vw, 20px);
        border-bottom: 1px solid var(--hairline);
        flex-shrink: 0;
      }

      .owner {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
      }

      .owner-mark {
        width: 22px;
        height: 22px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
        color: var(--fixer);
        flex-shrink: 0;
      }

      .owner-meta {
        display: flex;
        flex-direction: column;
        min-width: 0;
      }

      .owner-name {
        font-size: 0.82rem;
        font-weight: 750;
        letter-spacing: -0.02em;
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .owner-sub {
        font-size: 0.64rem;
        color: var(--fixer);
        margin-top: 1px;
        white-space: nowrap;
      }

      .header-stats {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-shrink: 0;
      }

      .shell-status-pill {
        display: inline-flex;
        align-items: center;
        height: 24px;
        padding: 0 10px;
        border: 1px solid var(--hairline);
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--fixer);
        background: transparent;
      }

      .shell-status-pill[data-status="ok"] {
        border-color: rgba(52,211,153,0.25);
        color: #34d399;
      }

      .shell-status-pill[data-status="error"] {
        border-color: rgba(200,64,47,0.3);
        color: var(--safelight);
      }

      /* ── Workspace ──────────────────────────────────────────────── */
      .ide-workspace {
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
        position: relative;
      }

      /* ── Code shell header ──────────────────────────────────────── */
      .code-shell-header {
        height: 34px;
        display: flex;
        align-items: center;
        padding: 0 clamp(10px, 1.2vw, 16px);
        gap: 6px;
        border-bottom: 1px solid var(--hairline);
        flex-shrink: 0;
      }

      .shell-icon-btn {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 20px;
        padding: 0;
        border: none;
        background: transparent;
        color: var(--fixer);
        cursor: pointer;
        transition: color 0.2s ease, background-color 0.2s ease;
      }

      .shell-icon-btn:hover,
      .shell-icon-btn[data-view-active="true"] {
        color: var(--emulsion);
        background: var(--surface-up);
      }

      .breadcrumb-nav {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 0.66rem;
        color: var(--fixer);
        overflow: hidden;
        white-space: nowrap;
      }

      .breadcrumb-segment + .breadcrumb-segment::before {
        content: "/";
        margin-right: 5px;
        color: rgba(245,240,232,0.14);
      }

      .breadcrumb-segment[data-active="true"] {
        color: var(--emulsion);
        font-weight: 600;
      }

      /* ── Views ──────────────────────────────────────────────────── */
      .ide-view {
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
      }

      .ide-view[hidden] { display: none; }

      .ide-editor {
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: clamp(8px, 1.2vh, 14px) clamp(10px, 1.2vw, 16px);
      }

      .shell-widget-shell {
        display: grid;
        align-items: center;
        min-height: 80px;
        padding: 12px 14px;
        border: 1px dashed var(--hairline);
        background: var(--canvas);
      }

      .shell-widget-shell[data-widget-state="mounted"] {
        border-style: solid;
      }

      .shell-widget-shell[data-widget-kind="editor"] {
        flex: 1;
        min-height: 340px;
        display: block;
        padding: 0;
        overflow: hidden;
        background: var(--canvas);
      }

      .shell-widget-shell[data-widget-kind="editor"] > div {
        width: 100%;
        height: 100%;
        min-height: 0;
      }

      .shell-widget-shell[data-widget-kind="terminal"] {
        flex: 1;
        min-height: 280px;
        padding: 0;
        overflow: hidden;
        background: var(--canvas);
        border-style: solid;
      }

      .shell-widget-placeholder {
        margin: 0;
        color: var(--fixer);
        line-height: 1.5;
        font-size: 0.82rem;
      }

      .shell-editor-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
      }

      .shell-editor-note {
        color: var(--fixer);
        font-size: 0.7rem;
        font-weight: 500;
      }

      .shell-editor-note code {
        padding: 0.1rem 0.3rem;
        background: var(--surface-up);
        font-size: 0.92em;
      }

      /* ── Terminal ───────────────────────────────────────────────── */
      .ide-view-terminal {
        background: var(--canvas);
      }

      .stage-header {
        height: 34px;
        display: flex;
        align-items: center;
        padding: 0 clamp(10px, 1.2vw, 16px);
        border-bottom: 1px solid var(--hairline);
        gap: 8px;
        flex-shrink: 0;
      }

      .stage-title {
        font-size: 0.62rem;
        text-transform: uppercase;
        color: var(--stop-bath);
        letter-spacing: 0.12em;
        font-weight: 700;
      }

      .stage-subtitle {
        flex: 1;
        font-size: 0.62rem;
        color: var(--fixer);
      }

      /* ── Observability ──────────────────────────────────────────── */
      .ide-view-obs {
        background: var(--canvas);
        overflow-y: auto;
      }

      .obs-stream-label {
        font-size: 0.6rem;
        font-family: 'JetBrains Mono', 'Fira Code', 'SF Mono', monospace;
        color: var(--fixer);
      }

      .obs-activity-list {
        font-family: 'JetBrains Mono', 'Fira Code', 'SF Mono', monospace;
        min-height: 0;
        overflow-y: auto;
      }

      .obs-request-group {
        border-bottom: 1px solid var(--hairline);
      }

      .obs-activity-row {
        width: 100%;
        border: 0;
        background: transparent;
        color: #a9b1d6;
        text-align: left;
        padding: 10px clamp(10px, 1.2vw, 16px);
        cursor: pointer;
      }

      .obs-activity-row:hover { background: var(--surface); }

      .obs-activity-row[data-tone="error"] {
        background: rgba(200,64,47,0.06);
      }

      .obs-activity-line {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto auto;
        gap: 10px;
        align-items: baseline;
        font-size: 0.7rem;
      }

      .obs-activity-method { color: #c0caf5; font-weight: 700; }

      .obs-activity-path {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .obs-activity-status {
        font-variant-numeric: tabular-nums;
        color: #34d399;
      }

      .obs-activity-row[data-tone="error"] .obs-activity-status { color: var(--safelight); }

      .obs-activity-duration {
        color: #c0caf5;
        font-variant-numeric: tabular-nums;
      }

      .obs-activity-stage {
        display: block;
        margin-top: 4px;
        color: var(--fixer);
        font-size: 0.62rem;
      }

      .obs-expand { padding: 0 clamp(10px, 1.2vw, 16px) 10px; }

      .obs-expand-log {
        border: 1px solid var(--hairline);
        background: rgba(5,6,8,0.5);
        padding: 8px 10px;
        max-height: 200px;
        overflow-y: auto;
      }

      .obs-log-row {
        font-size: 0.64rem;
        line-height: 1.55;
        color: #a9b1d6;
        padding: 2px 0;
        white-space: pre-wrap;
        word-break: break-word;
      }

      .obs-log-row[data-kind="span_start"] { color: #7aa2f7; }
      .obs-log-row[data-kind="span_end"]   { color: #34d399; }
      .obs-log-row[data-kind="request"]    { color: #c0caf5; font-weight: 700; }
      .obs-log-row[data-tone="error"] {
        background: rgba(200,64,47,0.12);
        color: var(--safelight);
        font-weight: 700;
      }

      .obs-log-row[data-kind="span_end"] + .obs-log-row[data-kind="span_start"] {
        border-top: 1px solid var(--hairline);
        margin-top: 4px;
        padding-top: 6px;
      }

      .obs-trace-empty {
        color: var(--fixer);
        font-style: italic;
        padding: 12px clamp(10px, 1.2vw, 16px);
        font-size: 0.72rem;
      }

      /* ── Status footer ──────────────────────────────────────────── */
      .ide-status {
        padding: 6px clamp(10px, 1.2vw, 16px);
        border-top: 1px solid var(--hairline);
        text-align: center;
        font-size: 0.66rem;
        color: var(--fixer);
        letter-spacing: 0.04em;
        flex-shrink: 0;
        white-space: nowrap;
      }

      /* ── Payload switcher (inline in film strip) ────────────────── */
      .film-strip-payload-list {
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: 4px 0;
      }

      .film-strip-payload-btn {
        width: 100%;
        min-height: 26px;
        padding: 0 clamp(10px, 1.2vw, 16px);
        border: none;
        border-left: 2px solid transparent;
        background: transparent;
        color: var(--fixer);
        font-size: 0.72rem;
        font-weight: 500;
        letter-spacing: 0.02em;
        cursor: pointer;
        text-align: left;
        transition: color 0.2s ease, background-color 0.2s ease;
      }

      .film-strip-payload-btn:hover {
        background: var(--surface);
        color: var(--emulsion);
      }

      .film-strip-payload-btn[data-active="true"] {
        border-left-color: var(--developer);
        color: var(--developer);
        background: rgba(216,162,74,0.06);
        font-weight: 650;
      }

      /* ── Loader curtain ─────────────────────────────────────────── */
      .loader-curtain {
        position: fixed;
        inset: 0;
        z-index: 10000;
        pointer-events: none;
      }

      .loader-curtain-panel {
        position: absolute;
        left: 0;
        right: 0;
        height: 50vh;
        background: #050506;
      }

      .loader-curtain-panel--top    { top: 0; }
      .loader-curtain-panel--bottom { bottom: 0; }

      .loader-scan-line {
        position: absolute;
        left: 0;
        right: 0;
        height: 1px;
        top: 50%;
        background: rgba(216,162,74,0.5);
        box-shadow: 0 0 8px rgba(216,162,74,0.3);
        transform: scaleX(0);
      }

      .loader-counter {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-family: 'JetBrains Mono', 'Fira Code', 'SF Mono', monospace;
        font-size: clamp(0.7rem, 2vw, 1rem);
        color: var(--developer);
        letter-spacing: 0.12em;
        font-variant-numeric: tabular-nums;
      }

      /* ── Develop overlay ────────────────────────────────────────── */
      .develop-overlay {
        position: absolute;
        inset: 0;
        z-index: 10;
        pointer-events: none;
        background: var(--canvas);
      }

      /* ── Responsive ─────────────────────────────────────────────── */
      @media (max-width: 1100px) {
        .ide-film-strip { flex: 0 0 clamp(140px, 18vw, 200px); }
        .ide-panel       { flex: 0 0 clamp(320px, 46vw, 500px); }
      }

      @media (max-width: 860px) {
        .ide-shell { flex-direction: column; }

        .ide-film-strip {
          flex: 0 0 auto;
          flex-direction: row;
          border-right: none;
          border-bottom: 1px solid var(--hairline);
          overflow-x: auto;
          max-height: 44px;
        }

        .film-strip-head,
        .film-strip-files,
        .film-strip-foot,
        .film-strip-sep { display: none; }

        .ide-preview-zone { min-height: 40vh; }

        .ide-panel {
          flex: 1;
          border-left: none;
          border-top: 1px solid var(--hairline);
        }

        .ide-header {
          flex-direction: column;
          align-items: stretch;
        }

        .header-stats { justify-content: flex-start; flex-wrap: wrap; }
      }
    </style>
  </head>
  <body>
    <div class="loader-curtain" data-loader-curtain hidden>
      <div class="loader-curtain-panel loader-curtain-panel--top"></div>
      <div class="loader-curtain-panel loader-curtain-panel--bottom"></div>
      <div class="loader-scan-line"></div>
      <div class="loader-counter">000</div>
    </div>
    <main class="shell-stage">
      <include src="views/home.fuwa" />
    </main>
  </body>
</html>
