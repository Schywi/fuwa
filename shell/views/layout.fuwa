&unsafe doctype
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="htmx-config" content='{"historyEnabled":false,"selfRequestsOnly":false,"allowScriptTags":false}' />
    <title>&title</title>
    <link rel="stylesheet" href="/vendor/xterm/xterm-6.0.0.css" />
    <script type="importmap">
      {
        "imports": {
          "@codemirror/state": "/vendor/codemirror/state-6.6.0.js",
          "@codemirror/view": "/vendor/codemirror/view-6.43.0.js",
          "@marijn/find-cluster-break": "/vendor/codemirror/find-cluster-break-1.0.2.js",
          "crelt": "/vendor/codemirror/crelt-1.0.6.js",
          "style-mod": "/vendor/codemirror/style-mod-4.1.3.js",
          "w3c-keyname": "/vendor/codemirror/w3c-keyname-2.2.8.js"
        }
      }
    </script>
    <script src="/vendor/htmx/htmx-1.9.12.min.js"></script>
    <script defer src="/vendor/petite-vue/petite-vue-0.4.1.iife.js"></script>
    <script defer src="/shell/hooks/editor.js"></script>
    <script defer src="/shell/hooks/terminal.js"></script>
    <script defer src="/shell/hooks/workspace.js"></script>
    <script defer src="/shell/hooks/runtime-session.js"></script>
    <script defer src="/shell/hooks/preview-browser.js"></script>
    <script defer src="/shell/hooks/preview.js"></script>
    <style>
      :root {
        color-scheme: dark;
        --bg: #050608;
        --panel: #13151b;
        --panel-strong: #0d0d0f;
        --ink: #c0caf5;
        --muted: #8f97bb;
        --line: rgba(255, 255, 255, 0.04);
        --accent: #7ecfb3;
        --accent-strong: #9ece6a;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        height: 100vh;
        overflow: hidden;
        background: var(--bg);
        color: var(--ink);
        font-family: "IBM Plex Sans", ui-sans-serif, system-ui, sans-serif;
      }

      a,
      button,
      textarea,
      input,
      select {
        font: inherit;
      }

      .shell-stage {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background: rgba(10, 9, 13, 0.88);
        backdrop-filter: blur(6px);
      }

      .shell-content {
        width: min(860px, 96vw);
        height: 92vh;
      }

      .shell-kicker {
        margin: 0;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        font-size: 0.72rem;
        color: var(--accent);
        font-weight: 800;
      }

      .shell-badge {
        padding: 8px 12px;
        border-radius: 999px;
        background: var(--accent-soft);
        color: #fcd9ad;
        font-size: 0.74rem;
        font-weight: 750;
        white-space: nowrap;
      }

      .shell-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 38px;
        padding: 0 14px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: rgba(39, 39, 42, 0.9);
        color: var(--ink);
        font-size: 0.86rem;
        font-weight: 750;
        cursor: pointer;
        transition: transform 0.16s ease, box-shadow 0.16s ease, background-color 0.16s ease;
      }

      .shell-button:hover {
        transform: translateY(-1px);
        background: rgba(63, 63, 70, 0.95);
      }

      .shell-button[data-active=true] {
        color: #fff;
        background: linear-gradient(135deg, var(--accent), var(--accent-strong));
        border-color: transparent;
        box-shadow: 0 14px 28px rgba(159, 86, 23, 0.18);
      }

      .shell-button-meta {
        opacity: 0.78;
        font-size: 0.74rem;
        font-weight: 650;
      }

      /* IDE composition: left phone stage, right control panel. Height is
         bounded (not min-height) all the way from body down to here, so the
         flex:1;min-height:0;overflow:hidden chain below (preview stage,
         workspace, terminal) actually clips oversized content instead of the
         page growing to fit it. */
      .ide-shell {
        display: flex;
        gap: 5px;
        height: 100%;
      }

      .ide-island {
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--panel);
      }

      .ide-preview-island {
        position: relative;
        width: min(300px, 38vw);
        flex-shrink: 0;
        aspect-ratio: 9 / 16;
        background: var(--panel-strong);
        overflow: hidden;
      }

      .ide-preview-stage {
        width: 100%;
        height: 100%;
        border: 0;
        background: transparent;
        overflow: hidden;
      }

      .shell-preview-frame {
        display: block;
        width: 100%;
        height: 100%;
        border: 0;
        background: #0b0f14;
      }

      .ide-panel {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 5px;
      }

      .ide-header {
        padding: 14px 16px;
        flex-shrink: 0;
      }

      .header-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }

      .owner {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .owner-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: linear-gradient(135deg, #b48cff 0%, #c084fc 100%);
        color: #0d0d0f;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.65rem;
        font-weight: 700;
        flex-shrink: 0;
      }

      .owner-meta {
        display: flex;
        flex-direction: column;
      }

      .owner-name {
        font-size: 0.75rem;
        color: #e8e0f0;
        font-weight: 500;
      }

      .owner-sub {
        font-size: 0.625rem;
        color: #7ecfb3;
        letter-spacing: 0.02em;
        margin-top: 2px;
      }

      .stats {
        display: flex;
        gap: 12px;
      }

      .stat-item {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
      }

      .stat-label {
        font-size: 0.55rem;
        text-transform: uppercase;
        color: #565f89;
        letter-spacing: 0.08em;
      }

      .stat-value {
        font-size: 0.65rem;
        color: #d8ddf8;
        font-weight: 500;
        max-width: 220px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .asset-item {
        min-width: 84px;
      }

      .asset-switcher {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 2px;
      }

      .asset-switcher select {
        min-height: 24px;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 6px;
        background: #0d0f14;
        color: #d8ddf8;
        font: inherit;
        font-size: 0.62rem;
        padding: 0 6px;
      }

      .ide-workspace {
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        padding: 0;
        position: relative;
        background: var(--panel);
      }

      .ide-status {
        padding: 10px;
        text-align: center;
        font-size: 0.625rem;
        color: #7ecfb3;
        letter-spacing: 0.04em;
        flex-shrink: 0;
      }

      /* Code shell header: icon buttons, breadcrumb, popovers. */
      .code-shell-header {
        height: 38px;
        display: flex;
        align-items: center;
        padding: 0 12px;
        background: rgba(13, 16, 24, 0.92);
        gap: 8px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        flex-shrink: 0;
        position: relative;
        z-index: 20;
      }

      .shell-icon-btn {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        padding: 0;
        border: none;
        border-radius: 4px;
        background: transparent;
        color: #8f97bb;
        cursor: pointer;
        transition: background-color 0.16s ease, color 0.16s ease;
      }

      .shell-icon-btn:hover,
      .shell-icon-btn[data-open=true],
      .shell-icon-btn[data-view-active=true] {
        color: #c0caf5;
        background: rgba(255, 255, 255, 0.08);
      }

      .breadcrumb-nav {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 11px;
        color: #8f97bb;
        overflow: hidden;
        white-space: nowrap;
      }

      .breadcrumb-segment + .breadcrumb-segment::before {
        content: "/";
        margin-right: 6px;
        color: #4f577a;
      }

      .breadcrumb-segment[data-active=true] {
        color: #d8ddf8;
        font-weight: 600;
      }

      [v-cloak] {
        display: none !important;
      }

      .popover-v2 {
        position: absolute;
        top: calc(100% + 8px);
        background: rgba(15, 16, 26, 0.98);
        border: 1px solid #414868;
        border-radius: 10px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(16px);
        z-index: 40;
        overflow: hidden;
        display: flex;
        flex-direction: column;
      }

      .search-popover {
        left: 0;
        width: min(260px, 90vw);
      }

      .list-popover {
        right: 0;
        width: min(320px, 90vw);
      }

      .search-input-wrap {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 0 10px;
        height: 32px;
        border-bottom: 1px solid #27272a;
        color: #3d4466;
      }

      .search-input-wrap input {
        flex: 1;
        background: transparent;
        border: none;
        outline: none;
        font-size: 11px;
        color: #c0caf5;
      }

      .popover-list {
        max-height: 260px;
        overflow-y: auto;
        padding: 4px 0;
      }

      .popover-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 30px;
        padding: 0 10px;
        border-bottom: 1px solid #27272a;
      }

      .popover-header .label {
        font-size: 11px;
        font-weight: 700;
        color: #d8ddf8;
      }

      .popover-header .count {
        font-size: 10px;
        color: #8f97bb;
      }

      .popover-row,
      .popover-row-rich {
        display: flex;
        align-items: center;
        gap: 7px;
        min-height: 26px;
        padding: 0 10px;
        cursor: pointer;
        font-size: 11px;
        color: #a9b1d6;
        appearance: none;
        border: 0;
        border-left: 2px solid transparent;
        background: transparent;
        width: 100%;
        text-align: left;
      }

      .popover-row:hover,
      .popover-row-rich:hover,
      .popover-row[data-focused=true],
      .popover-row-rich[data-focused=true] {
        background: rgba(63, 63, 70, 0.5);
      }

      .popover-row[data-selected=true],
      .popover-row-rich[data-selected=true] {
        background: rgba(52, 211, 153, 0.14);
        border-left-color: #34d399;
        color: #c0caf5;
      }

      .popover-row .glyph {
        width: 10px;
        color: #565f89;
        font-family: monospace;
      }

      .popover-row-rich {
        display: grid;
        grid-template-columns: 12px 36px 1fr;
        gap: 6px;
        align-items: center;
      }

      .popover-row-rich .dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #7aa2f7;
      }

      .popover-row-rich .badge {
        font-size: 0.56rem;
        font-weight: 800;
        padding: 1px 3px;
        border-radius: 3px;
        color: #7aa2f7;
        background: rgba(122, 162, 247, 0.09);
      }

      .popover-row-rich .title {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      /* Workspace views: code + terminal share the panel body. */
      .ide-view {
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
      }

      .ide-view[hidden] {
        display: none;
      }

      .ide-editor {
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
        gap: 0;
        padding: 0;
      }

      .shell-widget-shell {
        display: grid;
        align-items: center;
        min-height: 112px;
        padding: 14px 16px;
        border: 1px dashed rgba(255, 255, 255, 0.12);
        border-radius: 0;
        background: rgba(255, 255, 255, 0.03);
      }

      .shell-widget-shell[data-widget-state="mounted"] {
        border-style: solid;
      }

      .shell-widget-shell[data-widget-kind="editor"] {
        flex: 1;
        min-height: 380px;
        display: block;
        padding: 0;
        overflow: hidden;
        background: #0b0f14;
        border: 0;
      }

      .shell-widget-shell[data-widget-kind="editor"] > div {
        width: 100%;
        height: 100%;
        min-height: 0;
      }

      .shell-widget-shell[data-widget-kind="terminal"] {
        flex: 1;
        min-height: 320px;
        padding: 0;
        overflow: hidden;
        background: #09090b;
        border: 0;
      }

      .shell-widget-placeholder {
        margin: 0;
        color: var(--muted);
        line-height: 1.5;
        font-size: 0.88rem;
      }

      .shell-editor-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        padding: 10px 12px;
      }

      .shell-editor-note {
        color: var(--muted);
        font-size: 0.8rem;
      }

      .shell-editor-note code {
        padding: 0.14rem 0.35rem;
        border-radius: 0.4rem;
        background: rgba(255, 255, 255, 0.06);
        font-size: 0.9em;
      }

      .ide-view-terminal {
        background: #09090b;
      }

      .stage-header {
        height: 38px;
        display: flex;
        align-items: center;
        padding: 0 12px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        gap: 10px;
        flex-shrink: 0;
      }

      .stage-title {
        font-size: 0.66rem;
        text-transform: uppercase;
        color: #7aa2f7;
        letter-spacing: 0.1em;
        font-weight: 700;
      }

      .stage-subtitle {
        flex: 1;
        font-size: 0.66rem;
        color: #94a3b8;
      }

      .ide-view-terminal .shell-widget-shell {
        border-radius: 0 0 22px 22px;
        border: 0;
      }

      .shell-status-pill {
        display: inline-flex;
        align-items: center;
        font-size: 0.65rem;
        font-weight: 500;
        color: #d8ddf8;
      }

      .shell-status-pill[data-status="ready"] {
        color: #9ece6a;
      }

      .shell-status-pill[data-status="error"] {
        color: #fb7185;
      }

      .shell-status-pill[data-status="idle"] {
        color: #8f97bb;
      }

      .shell-preview-error {
        padding: 20px;
        color: #be185d;
        font-weight: 650;
      }

      @media (max-width: 1080px) {
        .ide-shell {
          flex-direction: column;
        }

        .ide-preview-island {
          flex: 0 0 500px;
          width: auto;
        }

        .shell-preview-frame {
          min-height: 480px;
        }
      }

      @media (max-width: 860px) {
        .shell-content {
          width: 100%;
          height: 100dvh;
        }

        .shell-stage {
          padding: 0;
        }

        .ide-shell {
          gap: 0;
        }

        .ide-header,
        .header-top {
          flex-direction: column;
          align-items: stretch;
        }

        .stats {
          justify-content: flex-start;
        }

        .stat-item {
          align-items: flex-start;
        }
      }
    </style>
  </head>
  <body>
      <main class="shell-stage">
      <include src="views/home.fuwa" />
    </main>
  </body>
</html>
