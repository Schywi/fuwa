<span id="ide-entry-stat" hx-swap-oob="true" style="display:none">&dashboard.active.selected_file</span>
<span id="ide-runtime-state" hx-swap-oob="true" class="shell-status-pill" data-status="&dashboard.active.terminal_status">&dashboard.active.terminal_label</span>
<span id="ide-runtime-state-text" hx-swap-oob="true">&dashboard.active.terminal_label</span>
<span id="ide-runtime-dot" hx-swap-oob="true" class="film-strip-status-dot" data-status="&dashboard.active.terminal_status"></span>
<footer id="ide-status" hx-swap-oob="true" class="ide-status">( •ω•)ﾉ✦ fuwa shell ready · &dashboard.active.terminal_label</footer>
