<section id="shell-content" class="shell-content">
  <div class="ide-shell" v-scope="FuwaShellWorkspace.createState()">
    <!-- ── Film strip ──────────────────────────────────────────── -->
    <nav class="ide-film-strip" aria-label="Payload files">
      <div class="film-strip-head">
        <div class="film-strip-project" data-film-strip-project>&dashboard.active.label</div>
      </div>

      <div class="film-strip-sep"></div>

      <div class="film-strip-files" role="listbox">
        <button
          f-for="file in dashboard.active.files"
          type="button"
          class="film-strip-file"
          data-selected="&file.selected"
          data-file-path="&file.path"
          hx-get="&file.inspect_url"
          hx-target="#ide-workspace"
          hx-swap="outerHTML"
        >
          <span class="film-strip-file-dot"></span>
          <span class="film-strip-file-name">&file.path</span>
        </button>
      </div>

      <div class="film-strip-sep"></div>

      <div class="film-strip-foot">
        <button type="button" class="shell-develop-btn" data-develop-btn>
          Develop
        </button>
        <div class="film-strip-status-line">
          <span class="film-strip-status-dot" data-status="&dashboard.active.terminal_status" id="ide-runtime-dot"></span>
          <span id="ide-runtime-state-text">&dashboard.active.terminal_label</span>
        </div>
      </div>
    </nav>

    <!-- ── Preview zone ────────────────────────────────────────── -->
    <section class="ide-preview-zone">
      <div
        class="ide-preview-stage"
        data-preview-stage
        data-payload-id="&dashboard.active.id"
        data-payload-route="&dashboard.active.route"
        data-runtime-tenant-url="&dashboard.runtime_tenant_url"
        data-runtime-worker-url="&dashboard.runtime_worker_url"
        data-bundle-url="&dashboard.active.bundle_url"
      >
        &unsafe dashboard.preview_html
      </div>
    </section>

    <!-- ── Right panel ─────────────────────────────────────────── -->
    <div class="ide-panel">
      <header class="ide-header">
        <div class="owner">
          <div class="owner-mark">✳</div>
          <div class="owner-meta">
            <div class="owner-name">&dashboard.title</div>
            <div class="owner-sub">&dashboard.eyebrow · &dashboard.active.file_count files</div>
          </div>
        </div>

        <div class="header-stats">
          <span id="ide-runtime-state" class="shell-status-pill" data-status="&dashboard.active.terminal_status">&dashboard.active.terminal_label</span>
        </div>
      </header>

      <include src="views/fragments/workspace.fuwa" />

      <footer id="ide-status" class="ide-status">( •ω•)ﾉ✦ fuwa shell ready · &dashboard.active.terminal_label</footer>
    </div>
  </div>
</section>
