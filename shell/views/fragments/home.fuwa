<section id="shell-content" class="shell-content">
  <div class="ide-shell" v-scope="FuwaShellWorkspace.createState()" :class="{ 'is-dash': panelOpen }">
    <section class="ide-island ide-preview-island">
      <div
        class="ide-preview-stage"
        data-preview-stage
        data-payload-id="&dashboard.active.id"
        data-payload-route="&dashboard.active.route"
        data-runtime-tenant-url="&dashboard.runtime_tenant_url"
        data-runtime-worker-url="&dashboard.runtime_worker_url"
        data-bundle-url="&dashboard.active.bundle_url"
      >
        &unsafe dashboard.preview_html
      </div>
    </section>

    <div class="ide-panel">
      <header class="ide-island ide-header">
        <div class="owner-sub typewriter-line"></div>
        <button class="grafana-trigger" @click="toggleArch()">architecture ↗</button>
        <button type="button" class="grafana-trigger" data-deploy-trigger style="margin-left:4px">Deploy</button>
        <button class="grafana-trigger" style="margin-left:4px" @click="openDrawer()">Assistant ⌘</button>
        <button class="grafana-trigger" style="margin-left:4px" @click="openPanel('http://192.168.0.242/browser/?dbms=bolt%3A%2F%2F192.168.0.242%3A7687&amp;db=neo4j&amp;preselectAuthMethod=NO_AUTH')">Neo4j ◈</button>
      </header>

      <include src="views/fragments/workspace.fuwa" />

      <footer id="ide-status" class="ide-island ide-status">( •ω•)ﾉ✦ &dashboard.footer_label · &dashboard.active.terminal_label</footer>
    </div>

    <section class="ide-island ide-preview-island ide-preview-island--right">
      <div class="ide-preview-block ide-preview-block--terminal">
        <div class="stage-header">
          <span class="stage-title">Terminal</span>
          <span class="stage-subtitle">compile + run output</span>
          <button class="grafana-trigger" @click="toggleTmux()">tmux|debug ↗</button>
        </div>
        <div
          class="shell-widget-shell"
          data-terminal-root
          data-terminal-session="&dashboard.active.id"
          data-terminal-status="&dashboard.active.terminal_status"
          data-terminal-run-id="&dashboard.active.terminal_run_id"
          aria-label="xterm terminal mount point"
        >
          <p class="shell-widget-placeholder">xterm mounts here.</p>
        </div>
        <pre id="ide-terminal-seed" hidden data-terminal-seed>&dashboard.active.terminal_output</pre>
      </div>
      <div class="ide-preview-block ide-preview-block--obs">
        <div class="stage-header">
          <span class="stage-title">Observability</span>
          <button class="grafana-trigger" @click="openPanel('http://192.168.0.245/')">Grafana ↗</button>
          <button class="grafana-trigger" @click="openPanel('http://192.168.0.241/')">Cilium ↗</button>
        </div>
        <div class="obs-activity-list" data-obs-root v-pre>
          <div v-for="request in requests" class="obs-request-group">
            <button type="button" class="obs-activity-row" :data-tone="statusTone(request)" @click="toggleExpand(request)">
              <span class="obs-activity-line">
                <span class="obs-activity-method" v-text="request.method"></span>
                <span class="obs-activity-path" v-text="request.path"></span>
                <span class="obs-activity-status" v-text="request.statusLabel"></span>
                <span class="obs-activity-duration" v-text="request.durationLabel"></span>
              </span>
              <span class="obs-activity-stage" v-text="request.stageSummary"></span>
            </button>
            <div v-show="expandedTraceId === request.traceId" class="obs-expand">
              <div class="obs-expand-log">
                <div v-for="line in request.logs" class="obs-log-row" :data-kind="line.kind" :data-tone="line.tone" v-text="line.label"></div>
              </div>
            </div>
          </div>
          <div v-show="requests.length === 0" class="obs-trace-empty">
            No completed requests yet.
          </div>
        </div>
      </div>
    </section>

    <div class="grafana-panel dash-panel">
      <iframe class="grafana-frame" :src="panelUrl" sandbox="allow-scripts allow-same-origin allow-forms" title="dashboard"></iframe>
      <button class="grafana-back-btn" @click="closePanel()">← Back to code</button>
    </div>

    <aside class="assistant-drawer" v-show="drawerOpen">
      <header class="assistant-head">
        <h1>Cluster Assistant</h1>
        <span class="muted">read-only · local LLM</span>
        <nav class="assistant-links">
          <button type="button" @click="openAssistantLink('http://192.168.0.245/')">Grafana</button>
          <button type="button" @click="openAssistantLink('http://192.168.0.241/')">Hubble UI</button>
          <button type="button" @click="openAssistantLink('http://192.168.0.246/')">VictoriaMetrics</button>
        </nav>
        <button type="button" class="assistant-close" @click="closeDrawer()">✕</button>
      </header>
      <main class="assistant-thread" data-assistant-thread></main>
      <form class="assistant-composer" @submit.prevent="sendAssistant()">
        <select name="mode" v-model="assistantMode" title="investigate = multi-step tool loop; chat = one step">
          <option value="investigate">investigate</option>
          <option value="chat">chat</option>
        </select>
        <input
          name="message"
          v-model="assistantInput"
          placeholder="Ask about the cluster…"
          autocomplete="off"
        />
        <button class="send" type="submit" :disabled="assistantBusy">Send</button>
      </form>
      <div class="assistant-toast" data-assistant-toast></div>
    </aside>

    <div class="tmux-panel">
      <button class="grafana-back-btn" @click="toggleTmux()">← Back to code</button>
      <button class="grafana-back-btn tmux-filter-btn" data-tmux-filter-btn style="right: auto; left: 14px;">Errors only</button>
      <div class="tmux-grid">
        <div class="tmux-slot" data-tmux-root data-tmux-slot="fuwa" data-tmux-selector="app.kubernetes.io/name=fuwa" data-tmux-label="fuwa"></div>
        <div class="tmux-slot" data-tmux-root data-tmux-slot="grafana" data-tmux-selector="app.kubernetes.io/name=grafana" data-tmux-label="grafana"></div>
        <div class="tmux-slot" data-tmux-root data-tmux-slot="victoriametrics" data-tmux-selector="app.kubernetes.io/name=victoriametrics" data-tmux-label="victoria"></div>
        <div class="tmux-slot" data-tmux-root data-tmux-slot="otel" data-tmux-selector="app.kubernetes.io/name=otel-collector" data-tmux-label="otel"></div>
        <div class="tmux-slot" data-tmux-root data-tmux-slot="tempo" data-tmux-selector="app.kubernetes.io/name=tempo" data-tmux-label="tempo"></div>
        <div class="tmux-slot" data-tmux-root data-tmux-slot="hubble" data-tmux-selector="k8s-app=hubble-relay" data-tmux-label="hubble"></div>
        <div class="tmux-slot" data-tmux-root data-tmux-slot="cilium" data-tmux-selector="k8s-app=cilium" data-tmux-label="cilium"></div>
      </div>
    </div>

    <div class="arch-panel">
      <button class="grafana-back-btn" @click="toggleArch()">← Back to code</button>
      <div class="arch-zoom-bar">
        <button class="arch-zoom-btn" data-arch-zoom="in" title="Zoom in">+</button>
        <button class="arch-zoom-btn" data-arch-zoom="out" title="Zoom out">−</button>
        <button class="arch-zoom-btn" data-arch-zoom="reset" title="Reset">⟲</button>
      </div>
      <div class="arch-tabs">
        <button class="arch-tab arch-tab--active" data-arch-tab="frontend">Frontend</button>
        <button class="arch-tab" data-arch-tab="backend">Backend</button>
        <button class="arch-tab" data-arch-tab="infra">Infra</button>
      </div>
      <div class="arch-diagram" data-arch-diagram></div>
    </div>
  </div>
</section>
